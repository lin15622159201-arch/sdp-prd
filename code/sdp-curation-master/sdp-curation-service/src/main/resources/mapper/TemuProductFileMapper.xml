<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.tiangong.sdp.mapper.TemuProductFileMapper">
    <select id="logicOne" resultType="tech.tiangong.sdp.entity.TemuProductFile">
        SELECT t.*
        FROM temu_product_file t
        WHERE t.file_id = #{id}
    </select>
</mapper>

