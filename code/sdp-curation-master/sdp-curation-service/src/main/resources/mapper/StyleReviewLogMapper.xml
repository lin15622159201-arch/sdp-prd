<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.tiangong.sdp.mapper.StyleReviewLogMapper">

    <select id="getByStyleIds" resultType="tech.tiangong.sdp.entity.StyleReviewLog">
        SELECT *
        FROM (
        SELECT *,
        ROW_NUMBER() OVER (PARTITION BY style_id ORDER BY created_time DESC) as rn
        FROM style_review_log
        WHERE deleted = 0
        <if test="styleIds!=null and styleIds.size() > 0">
            AND style_id in
            <foreach collection="styleIds" item="styleId" index="index" open="(" close=")" separator=",">
                #{styleId}
            </foreach>
        </if>
        ) t
        WHERE t.rn = 1;
    </select>

</mapper>

