<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.tiangong.sdp.mapper.ImageUpdateResultMapper">
    <delete id="deleteByTaskIds">
        DELETE FROM image_update_result
        WHERE deleted = 0
        <choose>
            <when test="taskIds != null and taskIds.size > 0">
                AND task_id IN
                <foreach collection="taskIds" item="taskId" open="(" close=")" separator=",">
                    #{taskId}
                </foreach>
            </when>
            <otherwise>
                AND 1 = 0
            </otherwise>
        </choose>
    </delete>
</mapper>

